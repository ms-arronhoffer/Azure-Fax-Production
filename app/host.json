{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "concurrency": {"dynamicConcurrencyEnabled": false},
  "extensions": {
    "http": {"maxOutstandingRequests": 20, "maxConcurrentRequests": 4, "dynamicThrottlesEnabled": true},
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:02:00",
      "maxPollingInterval": "00:00:10",
      "messageEncoding": "base64"
    },
    "durableTask": {
      "hubName": "FaxPipeline",
      "maxConcurrentActivityFunctions": 2,
      "maxConcurrentOrchestratorFunctions": 5,
      "storeInputsInOrchestrationHistory": false,
      "tracing": {"traceInputsAndOutputs": false, "traceReplayEvents": false},
      "storageProvider": {"connectionName": "AzureWebJobsStorage"}
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Information",
      "Function": "Warning",
      "azure": "Warning",
      "azure.core.pipeline.policies.http_logging_policy": "None"
    },
    "applicationInsights": {
      "samplingSettings": {"isEnabled": true},
      "enableDependencyTracking": false,
      "enableLiveMetricsFilters": true
    }
  }
}
