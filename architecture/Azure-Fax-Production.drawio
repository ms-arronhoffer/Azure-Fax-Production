<mxCell id="classify-title" value="2. Classify each page" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="classify"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="classify-body" value="Page-level cover / body classification
Document Intelligence REST: split=perPage
Every page assigned once; confidence gated
Uncertain / missing page labels → review
This is NOT the fax-type decision" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="classify"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="cover-decision" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1235" y="235" width="510" height="245" as="geometry"/></mxCell>
<mxCell id="cover-decision-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="cover-decision"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="cover-decision-title" value="3. Cover page present?" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="cover-decision"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="cover-decision-body" value="YES: physically remove confident covers
NO: retain every body page
Preserve original-to-body page mapping
Empty body or ambiguous split → review
Cover removal is not malware scanning" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="cover-decision"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="classify-type" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1820" y="235" width="510" height="245" as="geometry"/></mxCell>
<mxCell id="classify-type-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="classify-type"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="classify-type-title" value="4. Classify type — NEW" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="classify-type"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="classify-type-body" value="Exam record / order / Rx / approved others
Classify logical fax using body evidence
Known type + calibrated confidence required
Unknown / low confidence / mixed → review
Select versioned extractor + required schema" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="classify-type"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="extract" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1820" y="650" width="510" height="265" as="geometry"/></mxCell>
<mxCell id="extract-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="extract"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="extract-title" value="5. Extract type-specific content" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="extract"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="extract-body" value="Analyze body bytes, not the cover
Use extractor selected by confirmed fax type
Required fields, nested items and page map
Capture every field value + confidence
Type selects downstream HL7 mapping policy" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="extract"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="gate" value="" style="rounded=1;arcSize=8;fillColor=#f7f1fc;strokeColor=#7252a3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1235" y="650" width="510" height="265" as="geometry"/></mxCell>
<mxCell id="gate-title" value="6. Automatic field gate" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="gate"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="gate-body" value="ALL expected fields present and valid
ALL scores finite, 0..1 and &gt;= 0.80
0.80 passes; 0.7999 or missing score fails
Minimum score, never average or round up
Type / business validation must also pass
PASS → automatic approval candidate" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="gate"><mxGeometry x="20" y="70" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="rejected" value="" style="rounded=1;arcSize=8;fillColor=#fff5f5;strokeColor=#b02e38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="510" height="265" as="geometry"/></mxCell>
<mxCell id="rejected-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="rejected"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="rejected-title" value="PendingHumanReview — NOT complete" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="rejected"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="rejected-body" value="human-review: original + draft + reasons
Preserve original scores and type evidence
No accepted output or release manifest
Unresolved / rejected cases remain held
Classification, field or input failures enter here" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="rejected"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="human-review" value="" style="rounded=1;arcSize=8;fillColor=#fff5f5;strokeColor=#b02e38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="650" width="510" height="265" as="geometry"/></mxCell>
<mxCell id="human-review-title" value="7. Human review — NEW workflow" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="human-review"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="human-review-body" value="Authorized reviewer verifies the original
Confirm fax type, body pages and all fields
Correct values; retain original machine scores
Re-extract with confirmed type if needed
Record reviewer identity, time and evidence
No approval until required data is resolved" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="human-review"><mxGeometry x="20" y="70" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="human-approved" value="" style="rounded=1;arcSize=8;fillColor=#f5fcf6;strokeColor=#26723e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="1060" width="510" height="245" as="geometry"/></mxCell>
<mxCell id="human-approved-title" value="Human-approved candidate — NEW" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="human-approved"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="human-approved-body" value="Validate corrected values and required fields
Audited approval + version / concurrency check
Do NOT raise machine scores to simulate 80%
approvalMode=human; original scores retained
Still NOT complete; transformation must run" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="human-approved"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="candidate" value="" style="rounded=1;arcSize=8;fillColor=#f5fcf6;strokeColor=#26723e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="1060" width="510" height="245" as="geometry"/></mxCell>
<mxCell id="candidate-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="candidate"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="candidate-title" value="8. Shared approved data contract" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="candidate"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="candidate-body" value="Merge auto OR human-approved candidates
Canonical fields, source and confirmed fax type
Track approvalMode=automatic / human
Evaluate ALL source / content / type routes
Freeze output plan + mapping / profile versions" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="candidate"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="hl7-required" value="" style="rounded=1;arcSize=8;fillColor=#f7f1fc;strokeColor=#7252a3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1235" y="1060" width="510" height="245" as="geometry"/></mxCell>
<mxCell id="hl7-required-title" value="9. HL7 required by output plan?" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="hl7-required"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="hl7-required-body" value="Per destination + fax type + selected data
YES: every required HL7 output must validate
Explicit NO: record NotApplicable + policy
Missing mapping is an ERROR, not a NO
Same decision for auto and human approval" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="hl7-required"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="hl7-skipped" value="" style="rounded=1;arcSize=8;fillColor=#f5fcf6;strokeColor=#26723e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1820" y="1060" width="510" height="245" as="geometry"/></mxCell>
<mxCell id="hl7-skipped-title" value="Explicitly no HL7 required" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="hl7-skipped"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="hl7-skipped-body" value="Versioned policy says NotApplicable
Persist the reason in the publication manifest
No silent skip for unsupported required data
JSON / all other required outputs still apply" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="hl7-skipped"><mxGeometry x="20" y="70" width="470" height="100" as="geometry"/></mxCell>
<mxCell id="transform" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1235" y="1460" width="510" height="270" as="geometry"/></mxCell>
<mxCell id="transform-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="transform"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="transform-title" value="10. Transform selected data to HL7" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="transform"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="transform-body" value="Function activity; versioned mapping per route
Receiver-approved HL7 version + profile
Map IDs, codes, units, timestamps and repeats
Escape delimiters; deterministic message IDs
Produce restricted working drafts only
NO invented / silently truncated clinical values" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="transform"><mxGeometry x="20" y="70" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="validate-hl7" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="1460" width="510" height="270" as="geometry"/></mxCell>
<mxCell id="validate-hl7-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="validate-hl7"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="validate-hl7-title" value="11. Validate ALL required HL7" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="validate-hl7"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="validate-hl7-body" value="Parse / schema / profile / required segments
Semantic checks and source-field reconciliation
Patient / encounter / order identity validation
Validate every message, not just the first
All pass → publish; ANY fail → hold
Re-run after every human correction" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="validate-hl7"><mxGeometry x="20" y="70" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="transform-hold" value="" style="rounded=1;arcSize=8;fillColor=#fff5f5;strokeColor=#b02e38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="1460" width="510" height="270" as="geometry"/></mxCell>
<mxCell id="transform-hold-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="transform-hold"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="transform-hold-title" value="Transform / validation hold" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="transform-hold"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="transform-hold-body" value="Retain draft, mapping version and safe reasons
No successful completion or release manifest
Retry bounded transient technical failures
Data issues → review → approve → transform
Mapping defects need an approved code fix
Never approve around failed HL7 validation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="transform-hold"><mxGeometry x="20" y="70" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="contract" value="" style="rounded=1;arcSize=8;fillColor=#f9fafc;strokeColor=#63758a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1820" y="1460" width="510" height="270" as="geometry"/></mxCell>
<mxCell id="contract-title" value="FAIL CLOSED — release contract" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="contract"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="contract-body" value="Human review is an approval path, not a bypass
Unknown type / missing schema → review
Required HL7 unavailable / invalid → hold
All approved data + HL7 + routes must persist
Consumers use only a completed manifest
Population accuracy is evaluated on page 3" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="contract"><mxGeometry x="20" y="70" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="primary-json" value="" style="rounded=1;arcSize=8;fillColor=#f5fcf6;strokeColor=#26723e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="1880" width="510" height="220" as="geometry"/></mxCell>
<mxCell id="primary-json-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="primary-json"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="primary-json-title" value="12. Persist approved primary" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="primary-json"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="primary-json-body" value="Store JSON + approval provenance
Automatic or explicitly human-reviewed result
Immutable, versioned publication identity
Not consumable until manifest is committed" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="primary-json"><mxGeometry x="20" y="70" width="470" height="100" as="geometry"/></mxCell>
<mxCell id="routed-blobs" value="" style="rounded=1;arcSize=8;fillColor=#f5fcf6;strokeColor=#26723e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="1880" width="510" height="220" as="geometry"/></mxCell>
<mxCell id="routed-blobs-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="routed-blobs"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="routed-blobs-title" value="13. Persist ALL planned artifacts" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="routed-blobs"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="routed-blobs-body" value="0..N JSON / selected HL7 route outputs
Require every planned write + hash check
Partial writes → retry / hold, NOT complete
No-match routes: primary is still required" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="routed-blobs"><mxGeometry x="20" y="70" width="470" height="100" as="geometry"/></mxCell>
<mxCell id="manifest" value="" style="rounded=1;arcSize=8;fillColor=#f5fcf6;strokeColor=#26723e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1235" y="1880" width="510" height="220" as="geometry"/></mxCell>
<mxCell id="manifest-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="manifest"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="manifest-title" value="14. Completion manifest LAST" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="manifest"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="manifest-body" value="Required HL7 validated OR explicit N/A
Primary + ALL planned artifacts committed
Record hashes, models, mappings and approval
Only now set status=Completed" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="manifest"><mxGeometry x="20" y="70" width="470" height="100" as="geometry"/></mxCell>
<mxCell id="consumer" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#087f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1820" y="1880" width="510" height="220" as="geometry"/></mxCell>
<mxCell id="consumer-title" value="Consumers / delivery boundary" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="consumer"><mxGeometry x="20" y="14" width="475" height="48" as="geometry"/></mxCell>
<mxCell id="consumer-body" value="Consume only manifest-listed, verified artifacts
Blob completion ≠ clinical receiver acceptance
If delivery added: track ACK / NACK separately
Receiver profile and HL7 version need approval" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="consumer"><mxGeometry x="20" y="70" width="470" height="100" as="geometry"/></mxCell>
<mxCell id="authoring" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#916719;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="2300" width="700" height="190" as="geometry"/></mxCell>
<mxCell id="authoring-icon" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="authoring"><mxGeometry x="18" y="17" width="43" height="43" as="geometry"/></mxCell>
<mxCell id="authoring-title" value="Separate model authoring" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="authoring"><mxGeometry x="75" y="14" width="610" height="48" as="geometry"/></mxCell>
<mxCell id="authoring-body" value="Train page classifier, fax-type classifier and extractors
Approved training-storage trusted-service exception
Evaluate by type/source; promote immutable model IDs
Runtime public access remains disabled" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="authoring"><mxGeometry x="20" y="70" width="660" height="100" as="geometry"/></mxCell>
<mxCell id="mapping-governance" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#916719;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="2300" width="710" height="190" as="geometry"/></mxCell>
<mxCell id="mapping-governance-title" value="HL7 and human-release governance — NEW" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="mapping-governance"><mxGeometry x="20" y="14" width="675" height="48" as="geometry"/></mxCell>
<mxCell id="mapping-governance-body" value="Receiver agrees message version, profile and field mappings
Clinical owner approves codes, units and identity matching
Review service requires RBAC, immutable audit and concurrency
Both paths must pass the same transformation checks" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="mapping-governance"><mxGeometry x="20" y="70" width="670" height="100" as="geometry"/></mxCell>
<mxCell id="implementation-boundary" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#916719;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1645" y="2300" width="660" height="190" as="geometry"/></mxCell>
<mxCell id="implementation-boundary-title" value="DESIGN ≠ current runtime" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="implementation-boundary"><mxGeometry x="20" y="14" width="625" height="48" as="geometry"/></mxCell>
<mxCell id="implementation-boundary-body" value="Existing app has page-derived type + 80% gate + JSON routes.
Dedicated type step, human release and HL7 are not coded.
Do not deploy this diagram as proof of those features.
See success-criteria.md and architecture README." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="implementation-boundary"><mxGeometry x="20" y="70" width="620" height="100" as="geometry"/></mxCell>
<mxCell id="classify-failure-label" value="Dashed red: invalid / uncertain / unknown / mixed → review" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#b02e38;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="592" width="810" height="23" as="geometry"/></mxCell>
<mxCell id="automatic-label" value="ALL fields pass → automatic approval" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26723e;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="950" y="950" width="550" height="23" as="geometry"/></mxCell>
<mxCell id="manual-label" value="Verified correction + explicit approval only" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26723e;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="980" width="475" height="23" as="geometry"/></mxCell>
<mxCell id="yes-label" value="YES → transform" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#0078d4;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1510" y="1365" width="200" height="23" as="geometry"/></mxCell>
<mxCell id="no-label" value="NO" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26723e;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1750" y="1105" width="70" height="23" as="geometry"/></mxCell>
<mxCell id="valid-label" value="ALL HL7 valid → publication" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26723e;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="680" y="1745" width="450" height="23" as="geometry"/></mxCell>
<mxCell id="publication-note" value="No cross-blob transaction. Manifest-last is the release barrier; neither saved review evidence nor a generated HL7 draft means Completed." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#087f8c;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="2122" width="2250" height="23" as="geometry"/></mxCell>
<mxCell id="workflow-footer" value="Proposed target workflow, not a measured accuracy or clinical-safety claim. A failed required check always blocks completion." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#63758a;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="2580" width="2280" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
