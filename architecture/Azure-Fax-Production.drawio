<mxCell id="reporting-heading" value="04 — Reporting metrics and operational insights" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=38;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="45" y="34" width="2300" height="50" as="geometry"/></mxCell>
<mxCell id="reporting-subtitle" value="PROPOSED REPORTING DESIGN • no live dashboard or new instrumentation deployed • targets reference page 3; no fabricated measurements" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#63758a;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="95" width="2300" height="36" as="geometry"/></mxCell>
<mxCell id="reporting-matrix" style="rounded=1;arcSize=3;fillColor=#f3f8fd;strokeColor=#bdd5e9;strokeWidth=2;connectable=0;" vertex="1" parent="1"><mxGeometry x="35" y="160" width="2330" height="1620" as="geometry"/></mxCell>
<mxCell id="reporting-matrix-title" value="HIGH-VALUE METRICS • show counts + denominators + trends + target + evidence status, not a single composite score" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="reporting-matrix"><mxGeometry x="20" y="14" width="2290" height="34" as="geometry"/></mxCell>
<mxCell id="report-1" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#087f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="240" width="745" height="335" as="geometry"/></mxCell>
<mxCell id="report-1-title" value="R1. Demand and throughput" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="report-1"><mxGeometry x="20" y="14" width="710" height="48" as="geometry"/></mxCell>
<mxCell id="report-1-body" value="KPIs: unique uploads, pages, completed faxes / hour
Breakout: fax type, source, file format, page count
Show arrivals vs completions and open work trend
Source: intake ledger + committed manifests
Cadence: 5-min operations; daily capacity trend
Action: sustained arrivals &gt; completions → capacity
Count business faxes, not retry events" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="report-1"><mxGeometry x="20" y="70" width="705" height="175" as="geometry"/></mxCell>
<mxCell id="report-2" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#087f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="745" height="335" as="geometry"/></mxCell>
<mxCell id="report-2-title" value="R2. Outcome funnel and automation [J]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="report-2"><mxGeometry x="20" y="14" width="710" height="48" as="geometry"/></mxCell>
<mxCell id="report-2-body" value="Upload → type → field gate → HL7 → completed
Auto releases / valid supported inputs; target &gt;= 70%
Separate human releases, held, failed and rejected
Breakout: type / source / model / approval mode
Source: deduplicated job transitions + manifests
Daily mature cohorts; show pending separately
Never hide rejects or reduce 80% to improve yield" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="report-2"><mxGeometry x="20" y="70" width="705" height="175" as="geometry"/></mxCell>
