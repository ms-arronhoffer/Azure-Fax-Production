<mxCell id="job-input-title" value="1. Resolve / normalize input" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="job-input"><mxGeometry x="75" y="14" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="job-input-body" value="Queue contains faxId only; load trusted source
Preserve original bytes and page mapping
Check media, size, page and parser limits
Normalize TIFF; idempotent job checkpoint
Invalid input → hold, never complete" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="job-input"><mxGeometry x="20" y="70" width="470" height="125" as="geometry"/></mxCell>
