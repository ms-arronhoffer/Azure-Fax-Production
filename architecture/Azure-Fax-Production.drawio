<mxCell id="metric-0" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#087f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="65" y="240" width="745" height="295" as="geometry"/></mxCell>
<mxCell id="metric-0-title" value="A. Fax-type classification" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="metric-0"><mxGeometry x="20" y="14" width="710" height="48" as="geometry"/></mxCell>
<mxCell id="metric-0-body" value="Macro-F1 &gt;= 0.98 on supported fax types
Recall &gt;= 0.97 for EACH supported type
Unknown / mixed detection recall &gt;= 0.99
Minimum 200 held-out faxes per supported type
Include exam record, order and Rx separately" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="metric-0"><mxGeometry x="20" y="70" width="705" height="125" as="geometry"/></mxCell>
<mxCell id="metric-1" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#087f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="745" height="295" as="geometry"/></mxCell>
<mxCell id="metric-1-title" value="B. Cover / page preservation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="metric-1"><mxGeometry x="20" y="14" width="710" height="48" as="geometry"/></mxCell>
<mxCell id="metric-1-body" value="Cover-removal precision &gt;= 0.999
Cover-removal recall &gt;= 0.99
ZERO clinically relevant body pages removed
Test cover, no-cover, repeats and poor scans
Any harmful deletion blocks release" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="metric-1"><mxGeometry x="20" y="70" width="705" height="125" as="geometry"/></mxCell>
<mxCell id="metric-2" value="" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#087f8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1615" y="240" width="745" height="295" as="geometry"/></mxCell>
<mxCell id="metric-2-title" value="C. Automatic fax correctness" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#17324d;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="metric-2"><mxGeometry x="20" y="14" width="710" height="48" as="geometry"/></mxCell>
<mxCell id="metric-2-body" value="All-required-fields-correct fax rate:
one-sided 95% lower bound &gt;= 0.99
Denominator: independently audited AUTO releases
Never average field accuracy across a fax
Evaluate each enabled type / source stratum" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#17324d;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="metric-2"><mxGeometry x="20" y="70" width="705" height="125" as="geometry"/></mxCell>
